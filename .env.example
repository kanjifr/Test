# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kizuna"

# --- Auth.js ---
# Génère une valeur avec : openssl rand -base64 32
AUTH_SECRET="change-moi"
# Nécessaire derrière un proxy / en Docker
AUTH_TRUST_HOST=true
# URL publique du site (ex: https://cartes.tacommu.fr)
AUTH_URL="http://localhost:3000"

# --- Application Discord (https://discord.com/developers/applications) ---
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ID du serveur Discord dont il faut être membre (vide = tout compte Discord accepté)
DISCORD_GUILD_ID=""

# IDs Discord des administrateurs, séparés par des virgules
ADMIN_DISCORD_IDS=""

# --- Réglages du jeu ---
NEXT_PUBLIC_SITE_NAME="Kizuna"
PACK_SIZE=5
PACK_COOLDOWN_HOURS=4

# Dossier où sont stockées les images envoyées depuis le panel admin
UPLOAD_DIR="./uploads"

# Connexion de test sans Discord (UNIQUEMENT en développement, jamais en production)
DEV_LOGIN=false
