# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kizuna"

# --- Auth.js ---
# Génère une valeur avec : openssl rand -base64 32
AUTH_SECRET="change-moi"
# Nécessaire derrière un proxy / en Docker
AUTH_TRUST_HOST=true
# URL publique du site (ex: https://cartes.tacommu.fr)
AUTH_URL="http://localhost:3000"

# --- Application Discord (https://discord.com/developers/applications) ---
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ID du serveur Discord dont il faut être membre (vide = tout compte Discord accepté)
DISCORD_GUILD_ID=""

# IDs Discord du ou des propriétaires du site, séparés par des virgules.
# Les propriétaires ont tous les droits et nomment les admins / modérateurs depuis le panel.
OWNER_DISCORD_IDS=""

# --- Réglages du jeu ---
SITE_NAME="Kizuna"
PACK_SIZE=5
PACK_COOLDOWN_HOURS=4

# Chance qu'une carte tirée soit une version brillante (0.02 = 1 sur 50)
SHINY_CHANCE=0.02

# Nombre de doublons à recycler pour gagner un booster bonus
RECYCLE_COST=10

# Duels : nombre de duels contre des membres par jour, contre un même membre, et boosters bonus
# gagnés pour la première victoire du jour (0 = pas de récompense)
DUEL_DAILY_LIMIT=10
DUEL_SAME_OPPONENT_LIMIT=3
DUEL_DAILY_REWARD=1

# Cartes Mythiques (système de pity)
# Chance de base par booster (0.004 = 0,4 %), hausse à partir du booster PITY_SOFT + 1, garantie au PITY_HARD-ième
MYTHIC_CHANCE=0.004
PITY_SOFT=110
PITY_HARD=140

# Sauvegarde automatique quotidienne : adresse d'un webhook d'un salon Discord PRIVÉ
# (Paramètres du salon → Intégrations → Webhooks). Vide = désactivée.
BACKUP_DISCORD_WEBHOOK_URL=""

# Annonces dans un salon Discord (grands tirages, duels, échanges) : adresse d'un webhook du salon
# d'annonces. Les réglages (rareté minimale, duels, échanges) se font dans Admin → Annonces Discord.
ANNOUNCE_DISCORD_WEBHOOK_URL=""

# Dossier où sont stockées les images envoyées depuis le panel admin
UPLOAD_DIR="./uploads"

# Connexion de test sans Discord (UNIQUEMENT en développement, jamais en production)
DEV_LOGIN=false
