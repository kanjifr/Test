generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rarity {
  COMMUNE
  RARE
  EPIQUE
  LEGENDAIRE
  MYTHIQUE
}

enum Element {
  EAU
  FLAMME
  FOUDRE
  VENT
  PIERRE
  BRUME
  FLEUR
  OMBRE
}

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  // Le membre accepte d'apparaître sur une carte
  consent       Boolean   @default(false)
  lastPackAt    DateTime?
  packsOpened   Int       @default(0)
  // Boosters ouverts depuis la dernière carte Mythique (système de pity)
  pityCount     Int       @default(0)
  // Boosters bonus à ouvrir sans attendre (recyclage, cadeaux des admins)
  bonusPacks    Int       @default(0)
  // Nombre total de doublons recyclés
  recycledCount Int       @default(0)
  // Duels : équipe de défense (3 identifiants de cartes, dans l'ordre) et palmarès
  defenseTeam   String[]  @default([])
  duelWins      Int       @default(0)
  duelLosses    Int       @default(0)
  // Anniversaire (jour et mois seulement, jamais l'année), renseigné par le membre
  birthMonth    Int?
  // Vitrine du profil public : jusqu'à 3 identifiants de cartes, dans l'ordre
  showcase      String[]  @default([])
  birthDay      Int?
  // Badge choisi pour être affiché à côté du pseudo
  featuredBadge String?
  // Rôle attribué depuis le site (le propriétaire est défini par OWNER_DISCORD_IDS)
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  cards      UserCard[]
  pulls      Pull[]
  featuredIn Card[]     @relation("CardSubject")

  tradesSent        Trade[]           @relation("TradeFrom")
  tradesReceived    Trade[]           @relation("TradeTo")
  achievements      UserAchievement[]
  adminLogs         AdminLog[]
  pollVotes         PollVote[]
  anecdotes         Anecdote[]        @relation("AnecdoteAuthor")
  anecdotesReviewed Anecdote[]        @relation("AnecdoteReviewer")
  pollOptions       PollOption[]
  duelsAttacked     Duel[]            @relation("DuelAttacker")
  duelsDefended     Duel[]            @relation("DuelDefender")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Card {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  name        String
  title       String   @default("")
  description String   @default("")
  rarity      Rarity
  element     Element
  attack      Int      @default(50)
  defense     Int      @default(50)
  imageUrl    String?
  // Vidéo jouée à l'obtention (cartes Mythiques uniquement)
  videoUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Série (saison) de la carte
  seriesId       String?
  series         Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // Carte d'événement : tirable seulement entre ces deux dates (vide = pas de limite)
  eventName      String?
  availableFrom  DateTime?
  availableUntil DateTime?
  // Version alternative d'une autre carte (même personne, autre style), plus rare à tirer
  variantOfId    String?
  variantOf      Card?     @relation("CardVariant", fields: [variantOfId], references: [id], onDelete: SetNull)
  variants       Card[]    @relation("CardVariant")

  subjectId String?
  subject   User?   @relation("CardSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  owners     UserCard[]
  pulls      Pull[]
  tradeItems TradeItem[]
  anecdotes  Anecdote[]
}

model UserCard {
  userId  String
  cardId  String
  // Nombre total d'exemplaires, versions brillantes comprises
  count   Int      @default(1)
  // Dont versions brillantes (shiny)
  shiny   Int      @default(0)
  firstAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
}

model Pull {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  isNew     Boolean
  shiny     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  CANCELLED
  EXPIRED
  FAILED
}

enum TradeSide {
  // Carte donnée par l'auteur de la proposition
  OFFER
  // Carte demandée au destinataire
  REQUEST
}

model Trade {
  id         String      @id @default(cuid())
  fromId     String
  toId       String
  status     TradeStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  resolvedAt DateTime?
  // Proposition à laquelle celle-ci répond (contre-proposition)
  parentId   String?

  from     User        @relation("TradeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to       User        @relation("TradeTo", fields: [toId], references: [id], onDelete: Cascade)
  parent   Trade?      @relation("TradeCounter", fields: [parentId], references: [id], onDelete: SetNull)
  counters Trade[]     @relation("TradeCounter")
  items    TradeItem[]

  @@index([toId, status])
  @@index([fromId, status])
}

model TradeItem {
  id       String    @id @default(cuid())
  tradeId  String
  cardId   String
  side     TradeSide
  quantity Int       @default(1)
  // Exemplaires brillants (sinon exemplaires normaux)
  shiny    Boolean   @default(false)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([tradeId, side, cardId, shiny])
}

model UserAchievement {
  userId        String
  // Identifiant du succès, défini dans src/lib/achievements.ts
  achievementId String
  unlockedAt    DateTime @default(now())
  // false tant que la notification n'a pas été affichée
  seen          Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId, seen])
}

model AdminLog {
  id        String   @id @default(cuid())
  actorId   String?
  // Pseudo au moment de l'action (reste lisible si le compte est supprimé)
  actorName String
  action    String
  details   String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum DuelResult {
  ATTACKER
  DEFENDER
  DRAW
}

model Duel {
  id         String     @id @default(cuid())
  attackerId String
  // Vide pour un entraînement contre l'ordinateur
  defenderId String?
  result     DuelResult
  // Déroulé complet du combat (cartes, coups, points de vie) pour la rediffusion
  log        Json
  // Booster bonus gagné grâce à ce duel
  rewarded   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  attacker User  @relation("DuelAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender User? @relation("DuelDefender", fields: [defenderId], references: [id], onDelete: Cascade)

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
}

/**
 * Réglages modifiables depuis le panel admin (clé → valeur).
 */
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum PollKind {
  // Les options sont des membres (qui aura la prochaine carte ?)
  MEMBERS
  // Les options sont des textes libres (titre, phrase…)
  TEXT
}

model Poll {
  id              String       @id @default(cuid())
  question        String
  kind            PollKind
  // Rareté de la carte en jeu (facultatif, simple information)
  rarity          Rarity?
  closesAt        DateTime
  resultAnnounced Boolean      @default(false)
  createdAt       DateTime     @default(now())
  options         PollOption[]
  votes           PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  label     String
  subjectId String?
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  subject   User?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  votes     PollVote[]
}

model PollVote {
  pollId    String
  userId    String
  optionId  String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
}

enum AnecdoteStatus {
  // Proposée par un membre, en attente de validation par le staff
  PENDING
  APPROVED
}

/**
 * Livre d'or : anecdotes et messages sur la personne représentée par une carte.
 */
model Anecdote {
  id           String         @id @default(cuid())
  cardId       String
  authorId     String?
  text         String
  status       AnecdoteStatus @default(PENDING)
  reviewedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  card       Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author     User? @relation("AnecdoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("AnecdoteReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([cardId, status])
  @@index([status, createdAt])
}

/**
 * Série de cartes (Saison 1, Saison 2…). Les anciennes séries restent dans les collections.
 */
model Series {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // Les cartes de la série sortent dans les boosters
  inBoosters  Boolean  @default(true)
  createdAt   DateTime @default(now())
  cards       Card[]
}
