generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rarity {
  COMMUNE
  RARE
  EPIQUE
  LEGENDAIRE
}

enum Element {
  EAU
  FLAMME
  FOUDRE
  VENT
  PIERRE
  BRUME
  FLEUR
  OMBRE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  // Le membre accepte d'apparaître sur une carte
  consent       Boolean   @default(false)
  lastPackAt    DateTime?
  packsOpened   Int       @default(0)
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  cards      UserCard[]
  pulls      Pull[]
  featuredIn Card[]     @relation("CardSubject")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Card {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  name        String
  title       String   @default("")
  description String   @default("")
  rarity      Rarity
  element     Element
  attack      Int      @default(50)
  defense     Int      @default(50)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  subjectId String?
  subject   User?   @relation("CardSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  owners UserCard[]
  pulls  Pull[]
}

model UserCard {
  userId  String
  cardId  String
  count   Int      @default(1)
  firstAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
}

model Pull {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  isNew     Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
